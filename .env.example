# Copy to `.env` (git-ignored). Never commit real values.

# ---- Frontend (Vite) -------------------------------------------------
# Supabase Dashboard -> Project Settings -> API.
# Public by design (shipped to the browser); Row Level Security protects data.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Local database scripts only (scripts/db/*) ----------------------
# Never prefix with VITE_. Project Settings -> Database -> Session pooler.
# URL-encode special characters in the password (e.g. '@' -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional: demo account for `npm run db:seed` / db:check
DEMO_EMAIL=
DEMO_PASSWORD=
