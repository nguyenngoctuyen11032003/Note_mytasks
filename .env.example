# Copy to `.env` for local development (the real file is git-ignored).
# Supabase dashboard -> Project Settings -> API
#
# ONLY these two values belong in the frontend:
#   - Project URL
#   - anon / public key   (safe to expose BY DESIGN — Row Level Security protects the data)
#
# NEVER put the `service_role` key or the database password anywhere in this project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
